# Neon PostgreSQL connection string template
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Secret dùng để ký JWT (BẮT BUỘC cho Auth).
# Mỗi máy tự tạo 1 chuỗi ngẫu nhiên cho file .env của mình, KHÔNG commit giá trị thật.
# Tạo bằng lệnh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# C3-03 check-in và C3-09 auto-recall chạy nền khi bật (mặc định tắt ở local/dev)
ENABLE_C3_BACKGROUND=false
# true = C3-03/C3-09 chỉ đọc và ghi log, không sửa DB
C3_JOB_DRY_RUN=false
